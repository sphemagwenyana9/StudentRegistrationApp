@model IEnumerable<StudentRegistrationApp.Models.Student>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Students</h1>

        <a class="btn btn-primary" asp-action="Create">
            Add Student
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            Student List
        </div>

        <div class="card-body">
            <table class="table table-striped table-hover table-bordered">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td>@student.StudentId</td>
                            <td>@student.FullName</td>
                            <td>@student.Email</td>
                            <td>@student.PhoneNumber</td>
                            <td>
                                <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@student.StudentId">
                                    Edit
                                </a>

                                <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@student.StudentId">
                                    Details
                                </a>

                                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@student.StudentId">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>