@model IEnumerable<StudentRegistrationApp.Models.Registration>

<h1>Registrations</h1>

<a asp-action="Create" class="btn btn-primary mb-3">Register Student</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Student</th>
            <th>Course</th>
            <th>Date Registered</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var registration in Model)
        {
            <tr>
                <td>@registration.RegistrationId</td>
                <td>@registration.Student.FullName</td>
                <td>@registration.Course.CourseName</td>
                <td>@registration.RegistrationDate</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@registration.RegistrationId" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@registration.RegistrationId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>