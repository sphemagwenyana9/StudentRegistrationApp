@model StudentRegistrationApp.Models.Registration

<h1>Register Student</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Student</label>
        <select asp-for="StudentId" asp-items="ViewBag.StudentId" class="form-control"></select>
    </div>

    <div class="mb-3">
        <label class="form-label">Course</label>
        <select asp-for="CourseId" asp-items="ViewBag.CourseId" class="form-control"></select>
    </div>

    <button type="submit" class="btn btn-success">Register</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>